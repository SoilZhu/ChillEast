<?xml version="1.0" encoding="utf-8"?>
<!-- 快捷功能 2x2：无底色，大图标 + 功能名，点击整格直达。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="4dp"
            android:layout_height="16dp"
            android:background="#09C489" />

        <TextView
            android:id="@+id/widget_quick_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_quick_label"
            android:textColor="@color/widget_title"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_quick_cell_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_quick_icon_0"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/widget_quick_label"
                android:src="@drawable/widget_ic_payment_code" />

            <TextView
                android:id="@+id/widget_quick_label_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/widget_open_hint"
                android:textColor="@color/widget_title"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_quick_cell_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_quick_icon_1"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/widget_quick_label"
                android:src="@drawable/widget_ic_library" />

            <TextView
                android:id="@+id/widget_quick_label_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/widget_title"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_quick_cell_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_quick_icon_2"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/widget_quick_label"
                android:src="@drawable/widget_ic_empty_classroom" />

            <TextView
                android:id="@+id/widget_quick_label_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/widget_title"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_quick_cell_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_quick_icon_3"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/widget_quick_label"
                android:src="@drawable/widget_ic_bus" />

            <TextView
                android:id="@+id/widget_quick_label_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/widget_title"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
